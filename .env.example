# Frontend environment. Copy to .env.local for local development.
#
# Backend API base URL.
#   local dev  -> http://localhost:8000 (the FastAPI app in backend/)
#   production -> leave empty; the frontend uses same-origin relative URLs
VITE_API_URL=

# The backend has its own environment variables (JWT_SECRET, DATA_DIR, Stripe,
# Resend). They are process env vars, not read from this file — see README.md.
